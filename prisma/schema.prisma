generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Block {
  type      String
  data      Json
  createdAt DateTime  @default(now())
  endAt     DateTime?
  order     Int?
  startAt   DateTime?
  id        Int       @id @default(autoincrement())
  locale    String    @default("es")
  isActive  Boolean   @default(true)
}

model PromoBanner {
  id        Int       @id @default(autoincrement())
  image     String
  alt       String
  link      String?
  locale    String
  startAt   DateTime?
  endAt     DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model HeroSlide {
  id          Int       @id @default(autoincrement())
  image       String
  title       String
  highlight   String?
  description String?
  link        String?
  locale      String
  startAt     DateTime?
  endAt       DateTime?
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  imageMobile String?
  imageTablet String?

  @@unique([locale, order])
}

model Category {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  createdAt    DateTime              @default(now())
  parentId     String?
  type         CategoryType          @default(DOCTOR)
  blogs        Blog[]
  parent       Category?             @relation("CategoryToSub", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryToSub")
  translations CategoryTranslation[]
  doctors      DoctorCategory[]
  places       PlaceCategory[]

  @@unique([slug, type])
  @@index([parentId])
}

model Blog {
  title            String
  slug             String    @unique
  excerpt          String
  content          String
  image            String
  featured         Boolean   @default(false)
  views            Int       @default(0)
  published        Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  categoryId       String?
  isActive         Boolean   @default(true)
  locale           String    @default("es")
  id               Int       @id @default(autoincrement())
  translationGroup String?
  category         Category? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([views])
  @@index([createdAt])
  @@index([translationGroup])
}

model Doctor {
  id              String              @id @default(cuid())
  name            String
  slug            String              @unique
  email           String?
  phone           String?
  image           String?
  description     String?
  city            String?
  state           String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  userId          Int                 @unique
  analytics       Analytics[]
  contactRequests ContactRequest[]
  user            User                @relation(fields: [userId], references: [id])
  categories      DoctorCategory[]
  media           DoctorMedia[]
  places          DoctorPlace[]
  translations    DoctorTranslation[]
  homeFeatured    HomeFeatured[]
}

model DoctorTranslation {
  id          String  @id @default(cuid())
  doctorId    String
  locale      String
  name        String
  description String?
  city        String?
  state       String?
  doctor      Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, locale])
}

model DoctorCategory {
  doctorId   String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  doctor     Doctor   @relation(fields: [doctorId], references: [id])

  @@id([doctorId, categoryId])
}

model DoctorPlace {
  doctorId String
  placeId  String
  doctor   Doctor @relation(fields: [doctorId], references: [id])
  place    Place  @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([doctorId, placeId])
}

model DoctorMedia {
  id        String          @id @default(dbgenerated("gen_random_uuid()"))
  doctorId  String
  type      DoctorMediaType
  url       String
  title     String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  doctor    Doctor          @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
}

model DoctorInvitation {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    Int       @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model ContactRequest {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String
  doctorId  String?
  createdAt DateTime @default(now())
  doctor    Doctor?  @relation(fields: [doctorId], references: [id])
}

model User {
  id               Int                  @id @default(autoincrement())
  email            String               @unique
  password         String?
  role             Role                 @default(USER)
  resetExpires     DateTime?
  resetToken       String?
  doctor           Doctor?
  DoctorInvitation DoctorInvitation?
  passwordTokens   PasswordResetToken[]
  subscriptions    Subscription[]
}

model Place {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  type            PlaceType
  description     String?
  city            String?
  state           String?
  address         String?
  phone           String?
  image           String?
  createdAt       DateTime         @default(now())
  facebook        String?
  instagram       String?
  isActive        Boolean          @default(true)
  mobile          String?
  phone2          String?
  postalCode      String?
  twitter         String?
  website         String?
  youtube         String?
  locale          String?          @default("es")
  navbarOrder     Int?
  showInNavbar    Boolean          @default(false)
  email           String?
  doctors         DoctorPlace[]
  homeFeatured    HomeFeatured[]
  navigationItems NavigationItem[]
  categories      PlaceCategory[]
  images          PlaceImage[]
  treatments      PlaceTreatment[]
}

model PlaceCategory {
  placeId    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([placeId, categoryId])
}

model PlaceImage {
  id      Int    @id @default(autoincrement())
  url     String
  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model HomeFeatured {
  id        String   @id @default(cuid())
  type      String
  order     Int      @unique
  doctorId  String?
  placeId   String?
  createdAt DateTime @default(now())
  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  place     Place?   @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([doctorId])
  @@index([placeId])
}

model Treatment {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  places    PlaceTreatment[]
}

model PlaceTreatment {
  placeId     String
  treatmentId String
  place       Place     @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  treatment   Treatment @relation(fields: [treatmentId], references: [id])

  @@id([placeId, treatmentId])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    Int
  plan      String
  status    String
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

model Analytics {
  id        String        @id @default(cuid())
  doctorId  String
  createdAt DateTime      @default(now())
  type      AnalyticsType
  doctor    Doctor        @relation(fields: [doctorId], references: [id])
}

model NavigationItem {
  id        String   @id @default(cuid())
  title     String
  slug      String
  url       String
  locale    String   @default("es")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  placeId   String?
  createdAt DateTime @default(now())
  place     Place?   @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Faq {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  question  String
  answer    String
  locale    String    @default("es")
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  startAt   DateTime? @db.Timestamp(6)
  endAt     DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  @@index([isActive], map: "idx_faq_active")
  @@index([locale], map: "idx_faq_locale")
  @@index([order], map: "idx_faq_order")
}

model Magazine {
  id               String   @id @default(cuid())
  title            String
  coverImage       String
  description      String?
  url              String
  edition          String?
  isFeatured       Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  locale           String   @default("es")
  translationGroup String?

  @@index([isActive])
  @@index([locale])
  @@index([translationGroup])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String
  name       String
  slug       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([slug, locale])
  @@index([locale])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

enum CategoryType {
  BLOG
  DOCTOR
  PLACE
}

enum Role {
  ADMIN
  USER
  DOCTOR
}

enum PlaceType {
  HOSPITAL
  CLINIC
  LAB
  DENTAL
  OFTALMOLOGY
}

enum AnalyticsType {
  PROFILE_VIEW
  CONTACT_CLICK
  PHONE_CLICK
  WHATSAPP_CLICK
}

enum DoctorMediaType {
  GALLERY
  CERTIFICATE
}
